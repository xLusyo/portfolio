---
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a href={href}><slot /></a>

<style>
	a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		min-height: 48px;
		padding: 0.8rem 1.25rem;
		border: 1px solid var(--accent-regular);
		border-radius: 8px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.4;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
	}

	a:hover {
		background: color-mix(in srgb, var(--accent-regular) 88%, var(--gray-0));
		border-color: color-mix(in srgb, var(--accent-regular) 88%, var(--gray-0));
		color: var(--accent-text-over);
	}

	a:focus-visible {
		outline: 3px solid var(--accent-regular);
		outline-offset: 4px;
	}

	a :global(svg) {
		flex-shrink: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		a {
			transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
		}

		a:active {
			transform: translateY(1px);
		}
	}

	@media (forced-colors: active) {
		a {
			border-color: ButtonText;
		}

		a:focus-visible {
			outline-color: Highlight;
		}
	}
</style>
