---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'start', tagline, title } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="copy stack gap-2">
		<h1 class="title">{title}</h1>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		min-width: 0;
		text-align: start;
		gap: 1.5rem;
	}

	.copy {
		gap: 1.25rem;
	}

	.title,
	.tagline {
		margin: 0;
	}

	.title {
		max-width: 24ch;
		font-size: clamp(2.25rem, 4.5vw, 4rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.045em;
		color: var(--gray-0);
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.tagline {
		max-width: 54ch;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.7;
		color: var(--gray-300);
		text-wrap: pretty;
	}

	.center {
		text-align: center;
	}

	.center .title,
	.center .tagline {
		margin-inline: auto;
	}
</style>
