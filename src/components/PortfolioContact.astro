---
import { portfolio } from '../data/portfolio';
---
<div class="mobile-contact"><span>Let’s build something.</span><button type="button" data-contact>Contact me ↗</button></div>
<dialog id="contact-dialog" aria-labelledby="contact-title" aria-describedby="contact-description">
	<button type="button" class="close-dialog" aria-label="Close contact dialog" autofocus>×</button>
	<span class="eyebrow">LET’S CONNECT</span>
	<h2 id="contact-title">Have a project in mind?</h2>
	<p id="contact-description">Tell me a little about it. This form prepares a draft in your email app; it does not send a message.</p>
	<form id="contact-form" data-email={portfolio.email}>
		<label>Your name<input name="name" autocomplete="name" required maxlength="150" /></label>
		<label>Your email<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
		<label>Your message<textarea name="message" rows="4" required maxlength="5000"></textarea></label>
		<button class="button contact" type="submit">Prepare email <span aria-hidden="true">↗</span></button>
		<small>Opens your email app with a draft to {portfolio.email}.</small>
		<p class="contact-status" role="status" aria-live="polite"></p>
	</form>
</dialog>
