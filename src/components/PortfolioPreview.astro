---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import ProjectBadges from './ProjectBadges.astro';
import { Image, getImage } from 'astro:assets';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
// Share the full-size transform with the no-JavaScript fallback link.
const previewWidth = Math.min(1920, data.img.width);
const fullPreview = await getImage({ src: data.img, width: previewWidth, format: 'webp' });
---

<article class="card" data-project-id={id}>
	<a class="preview" href={fullPreview.src} data-project-open={id} aria-label={`Preview ${data.title}`} aria-haspopup="dialog" aria-controls="project-lightbox">
		<Image
			src={data.img}
			alt={data.img_alt || data.title}
			width={720}
			height={450}
			widths={[360, 720, 1080, 1440]}
			sizes="(min-width: 1051px) calc((100vw - 460px) / 3), (min-width: 761px) calc((100vw - 387px) / 2), calc(100vw - 62px)"
			format="webp"
			fit="cover"
			position="top"
			loading="lazy"
			decoding="async"
		/>
	</a>
	<div class="details">
		<h3 class="title"><a href={fullPreview.src} data-project-open={id} aria-haspopup="dialog" aria-controls="project-lightbox">{data.title}</a></h3>
		<ProjectBadges tags={data.tags} />
		{data.url && <a class="website" href={data.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${data.title} website (opens in a new tab)`}>Visit website <Icon icon="arrow-right" size="1em" /></a>}
	</div>
	<template data-project-template={id}>
		<header class="project-info">
			<h2 id="project-lightbox-title">{data.title}</h2>
			<ProjectBadges tags={data.tags} />
			{data.url && <a class="website" href={data.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${data.title} website (opens in a new tab)`}>Visit website <Icon icon="arrow-right" size="1em" /></a>}
		</header>
		<div class="project-media" aria-busy="true">
			<p class="image-status" role="status">Loading preview…</p>
			<Image
				src={data.img}
				alt={data.img_alt || data.title}
				width={previewWidth}
				widths={[480, 960, 1440, 1920]}
				sizes="(min-width: 72rem) 60rem, calc(100vw - 8rem)"
				format="webp"
				loading="eager"
				decoding="async"
			/>
		</div>
	</template>
</article>

<style>
	.card { min-width: 0; }
	.preview { display: block; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--gray-900); }
	.preview img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
	.details { display: grid; justify-items: start; gap: .875rem; padding: 1.5rem .75rem .75rem; }
	.title { font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 500; line-height: 1.3; letter-spacing: -.025em; overflow-wrap: anywhere; }
	.title a { color: var(--gray-0); text-decoration: none; }
	.title a:hover { text-decoration: underline; }
	.preview:hover { border-color: var(--accent-regular); }
	.website { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; font-size: var(--text-sm); font-weight: 600; white-space: nowrap; }
	.project-info { display: grid; justify-items: start; gap: 1rem; padding: .5rem var(--lightbox-padding) 1.5rem; }
	.project-info h2 { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; overflow-wrap: anywhere; }
	.project-media { min-height: 12rem; margin: 0 var(--lightbox-padding) var(--lightbox-padding); padding: clamp(.5rem, 1.5vw, 1rem); background: var(--gray-900); border: 1px solid var(--border); border-radius: var(--radius); }
	.project-media img { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: 8px; }
	.image-status { padding: 2rem 1.5rem; color: var(--gray-200); }
	.image-status[hidden], .project-media img[hidden] { display: none; }
	@media (prefers-reduced-motion: no-preference) {
		.preview { transition: border-color 160ms ease; }
		.preview img { transition: transform 200ms ease; }
		.preview:hover img { transform: scale(1.015); }
		.preview:active img { transform: scale(1); }
	}
</style>
