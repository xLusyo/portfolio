---
import Icon from './Icon.astro';
---

<section class="skills">
	<div class="skill" data-motion="reveal">
		<div class="skill-heading">
			<Icon icon="terminal-window" color="var(--accent-regular)" size="1.75rem" />
			<h2>Full Stack</h2>
		</div>
		<p>I build robust full stack solutions using Laravel, Livewire, React, and WordPress — connecting clean frontends with powerful backends to create scalable, efficient web systems.</p>
	</div>
	<div class="skill" data-motion="reveal">
		<div class="skill-heading">
			<Icon icon="trophy" color="var(--accent-regular)" size="1.75rem" />
			<h2>Core Expertise</h2>
		</div>
		<p>Building fast, secure, and maintainable websites using modern frameworks and workflow automation tools.</p>
	</div>
	<div class="skill" data-motion="reveal">
		<div class="skill-heading">
			<Icon icon="strategy" color="var(--accent-regular)" size="1.75rem" />
			<h2>Strategy-Minded</h2>
		</div>
		<p>Every project starts with a plan — combining technical insight with real-world strategy to build solutions that make sense and scale smoothly.</p>
	</div>
</section>

<style>
	.skills {
		border-bottom: 1px solid var(--border, var(--gray-800));
	}

	.skill {
		display: grid;
		gap: 1rem;
		padding-block: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--border, var(--gray-800));
	}

	.skill-heading {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.skill-heading :global(svg) {
		flex-shrink: 0;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.125rem, 2vw, 1.375rem);
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.025em;
	}

	p {
		margin: 0;
		max-width: 65ch;
		color: var(--gray-300);
		font-size: 1rem;
		line-height: 1.75;
	}

	@media (min-width: 50em) {
		.skill {
			grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
			align-items: start;
			gap: 2.5rem;
		}

		.skill-heading {
			padding-top: 0.2rem;
		}
	}
</style>
