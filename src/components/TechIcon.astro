---
import { iconPaths } from './IconPaths';

interface Props {
  icon: keyof typeof iconPaths;
}

const { icon } = Astro.props;
const iconPath = iconPaths[icon];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox={icon === 'html-logo' ? '0 0 32 32' : '0 0 24 24'}
  aria-hidden="true"
  focusable="false"
  fill="currentColor"
>
  <g set:html={iconPath} />
</svg>
