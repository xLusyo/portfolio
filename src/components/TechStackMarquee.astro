---
import TechIcon from './TechIcon.astro';
export interface TechItem { name: string; icon?: keyof typeof import('./IconPaths').iconPaths; }
export interface MarqueeRow { techStack: TechItem[]; direction: 'left' | 'right'; }
export interface Props { rows: MarqueeRow[]; speed?: number; }
const { rows } = Astro.props;
// Keep the existing component interface while presenting a readable, stationary tool grid.
---
<ul class="tools">
	{rows.flatMap((row) => row.techStack).map((tech) => (
		<li>{tech.icon && <span class="logo" aria-hidden="true"><TechIcon icon={tech.icon} /></span>}<span>{tech.name}</span></li>
	))}
</ul>
<style>
	.tools { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
	li { display: flex; gap: .75rem; align-items: center; padding: 1rem .5rem; color: var(--gray-200); font-size: var(--text-sm); }
	.logo { display: flex; width: 1.5rem; height: 1.5rem; flex-shrink: 0; color: var(--link-color); }
	/* The SVG is a child Astro component; use a scoped global descendant to size it. */
	.logo :global(svg) { display: block; width: 100%; height: 100%; flex: none; }
	@media (min-width: 35em) { .tools { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	@media (min-width: 50em) { .tools { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
	@media (min-width: 70em) { .tools { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
