---
import TechIcon from './TechIcon.astro';

export interface TechItem {
  name: string;
  icon?: keyof typeof import('./IconPaths').iconPaths;
}

export interface MarqueeRow {
  techStack: TechItem[];
  direction: 'left' | 'right';
}

export interface Props {
  rows: MarqueeRow[];
  speed?: number; // seconds for one full cycle
}

const { rows, speed = 30 } = Astro.props;

// Create multiple copies for smooth infinite scroll
const createInfiniteItems = (techStack: TechItem[], copies = 3) => {
  const result: TechItem[] = [];
  for (let i = 0; i < copies; i++) {
    result.push(...techStack);
  }
  return result;
};
---

<div class="tech-stack-marquee">
  {rows.map((row, rowIndex) => (
    <div class="marquee-row">
      <div
        class="marquee-track"
        style={`--speed: ${speed}s; --direction: ${row.direction === 'left' ? 'normal' : 'reverse'};`}
      >
        {createInfiniteItems(row.techStack).map((tech, index) => (
          <div class="tech-item">
            {tech.icon ? (
              <span class="tech-logo">
                <TechIcon icon={tech.icon} />
              </span>
            ) : null}
            <span class="tech-name">{tech.name}</span>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .tech-stack-marquee {
    overflow: hidden;
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .marquee-row {
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    gap: 2rem;
    animation: scroll var(--speed) linear infinite;
    animation-direction: var(--direction);
    white-space: nowrap;
    will-change: transform;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--gray-100);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .tech-item:hover {
    background: var(--gray-800);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .tech-logo {
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .tech-logo svg {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% / 3));
    }
  }

  @media (min-width: 50em) {
    .tech-stack-marquee {
      gap: 1.5rem;
    }

    .tech-item {
      font-size: var(--text-base);
      padding: 0.75rem 1.5rem;
    }

    .tech-logo {
      width: 2rem;
      height: 2rem;
    }

    .tech-logo svg {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
