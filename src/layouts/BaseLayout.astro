---
import Footer from '../components/Footer.astro';
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import Analytics from '@vercel/analytics/astro';
interface Props {
	title?: string | undefined;
	description?: string | undefined;
}
const { title, description } = Astro.props;
---
<html lang="en">
	<head><MainHead title={title} description={description} /></head>
	<Analytics />
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<div class="stack backgrounds">
			<Nav />
			<div id="content" tabindex="-1"><slot /></div>
			<Footer />
		</div>
	</body>
</html>
<style>
	.backgrounds { min-height: 100dvh; isolation: isolate; border-top: 4px solid var(--turf-green); }
	.skip-link { position: absolute; left: 1rem; top: -5rem; z-index: 10000; padding: .75rem 1rem; background: var(--surface); border: 2px solid var(--link-color); border-radius: .5rem; }
	.skip-link:focus { top: 1rem; }
</style>
