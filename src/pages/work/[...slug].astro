---
import { type CollectionEntry, getCollection } from 'astro:content';

interface Props {
	entry: CollectionEntry<'work'>;
}

// Preserve existing project URLs on the single-page portfolio.
export async function getStaticPaths() {
	return (await getCollection('work')).map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

return Astro.redirect(`/#project=${encodeURIComponent(Astro.props.entry.id)}`, 301);
---
